# strata-xtx: welke variant dit is. Bepaalt namen en paden, zodat varianten naast elkaar in één container passen.
XTX_NAME=strata-xtx-rocm714                 # service-, config-, log- en state-naam
CMD_PREFIX=xtx714                           # commando's in /usr/local/bin: xtx714-update, xtx714-bench, ...
STRATA_DIR_DEFAULT=/opt/ai/strata-rocm714   # eigen clone van upstream met een eigen .venv (ROCm 7.14)
ROCM_VERSION_DEFAULT=7.14.0a20260612        # AMD TheRock-wheel, vast
ROCM_INDEX_DEFAULT=https://rocm.nightlies.amd.com/v2/gfx110X-all/   # 7.14 staat alleen in de -all-index
CONFLICTS="strata-xtx strata-xtx-rocm10"    # andere varianten op dezelfde GPU/poort (nooit tegelijk)
