# strata-xtx-rocm714 - instellingen. Wordt bij de eerste installatie gekopieerd naar /etc/strata-xtx-rocm714/xtx.conf.
# Variant met ROCm 7.14 (TheRock-wheels, index gfx110X-all). Past naast de standaardvariant (ROCm 7.10) in dezelfde
# container: eigen map, eigen .venv, eigen service (strata-xtx-rocm714), dezelfde modelbestanden en dezelfde poort.
# Er draait er altijd maar één. Wisselen:
#   systemctl disable --now strata-xtx-rocm714 && systemctl enable --now strata-xtx   (en omgekeerd)
# Shell-syntax (wordt ge-"source"d door de scripts). Alles hier heeft een werkende standaardwaarde.

# --- waar alles staat --------------------------------------------------------------------------------
STRATA_DIR=/opt/ai/strata-rocm714         # git clone van upstream (branch "xtx" = upstream + onze patches)
                                          # een oude zip-installatie hier wordt eerst opzij gezet (<map>.pre-xtx-<datum>)
DATA_DIR=/opt/ai/Strata-data             # modellen, packs, MTP (70-120 GB); = setup's standaard naast /opt/ai/strata,
                                          # dus een eerder gedownload model wordt hergebruikt
#XTX_DIR=/opt/ai/strata-xtx-rocm714      # deze overlay; standaard: de map waar de scripts staan
SERVICE_USER=strata                       # de engine draait als deze gebruiker (lid van render + video)

# --- upstream ----------------------------------------------------------------------------------------
UPSTREAM_URL=https://github.com/Niko1221/Strata.git
UPSTREAM_BRANCH=main
KEEP_GOOD_TAGS=10                         # zoveel xtx-good-* tags (rollback-punten) blijven bewaard

# --- model (zie docs/MODELS.md van upstream) -----------------------------------------------------------
# IQ3_S: snelst gemeten op een 7900 XTX (~78-88 tok/s decode, ~1.600 tok/s prompt bij 38K) en past ruim in 90+ GB.
# Alternatief met meer kwaliteit: FAMILY=unsloth MODEL=UD-IQ4_XS (~72 GB RAM) of UD-Q4_K_XL (~88 GB RAM, LXC >= 104 GB).
FAMILY=qwen                               # qwen | swift | coder | unsloth
MODEL=IQ3_S                               # Q2_0 | IQ2_XS | IQ3_XXS | IQ3_S | UD-IQ4_XS | UD-Q4_K_XL ...
CONTEXT=262144
KV=int8                                   # int8 | q4_0 | k8v4
VISION=cpu                                # no | cpu   (AMD leest beelden alleen via de CPU-encoder)

# --- server ------------------------------------------------------------------------------------------
HOST=0.0.0.0                              # headless LXC: bereikbaar vanaf het LAN
PORT=8080
API_KEY=                                  # leeg = geen sleutel; vul iets in om clients een sleutel te laten meesturen

# --- tuning ------------------------------------------------------------------------------------------
PROFILE=xtx-optimaal                            # stock | xtx-optimaal  (zie profiles/*.json)
AUTO_TUNE=yes                             # eigen hipBLASLt-tabel maken bij installatie en na een ROCm-wissel
AUTO_CALIBRATE=yes                        # Niko's decode-kalibratie (--calibrate) bij installatie, als die er nog niet is (15-30 min)
VRAM_RESERVE_MIB=512                      # headless kaart: geen desktop, dus minder reserve dan de standaard 700
# Geheugenplafond voor de engine. Proxmox-LXC ziet zijn eigen limiet vaak niet (upstream DETAILS.md: MemAvailable
# 25 GiB terwijl er 1 GiB over was). auto = MemTotal van de container min 2 GiB; 0 = niet zetten.
MEMORY_LIMIT_MIB=auto
RESIDENT_HEADROOM_GIB=                    # leeg = upstream-standaard (4); zie AMD_HIP.md "lend-coverage line"

# --- build -------------------------------------------------------------------------------------------
BUILD_JOBS=                               # leeg = alle cores van de container (patch 0001)
EXTRA_CMAKE_ARGS=                         # bv. "-DSTRATA_ORCA_Q4KS_MMQ=ON" (patch 0001)
# ROCm: leeg = setup's geteste TheRock-wheels in .venv (geen sudo, ~10 GB). Een eigen versie/index kan, maar dan
# moet er een hipBLASLt-tabel bij die versie horen (xtx-tune-hipblaslt maakt er een).
ROCM_VERSION=7.14.0a20260612                # exacte TheRock-versie (nieuwste 7.14 bij het maken van deze variant)
ROCM_INDEX=https://rocm.nightlies.amd.com/v2/gfx110X-all/   # 7.14 bestaat niet in gfx110X-dgpu

# --- updates -----------------------------------------------------------------------------------------
UPDATE_SMOKE_TIMEOUT=900                  # seconden die een nieuwe build krijgt om te laden en "Paris" te antwoorden
UPGRADE_OS_PACKAGES=yes                   # xtx-update draait eerst xtx-tools (apt upgrade van de toolchain)
GIT_PPA=yes                               # Ubuntu: git uit ppa:git-core/ppa (nieuwste stabiele git)
